rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read/write access to authenticated users for locations
    match /locations/{document} {
      allow read: if true; // Public read access for locations
      allow write: if request.auth != null; // Authenticated users can write
    }
    
    // Allow read/write access to authenticated users for reviews
    match /reviews/{document} {
      allow read: if true; // Public read access for reviews
      allow write: if request.auth != null; // Authenticated users can write
    }
    
    // Allow read/write access to authenticated users for bookmarks
    match /bookmarks/{document} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // Allow read/write access to authenticated users for edit requests
    match /editRequests/{document} {
      allow read: if request.auth != null; // Authenticated users can read
      allow write: if request.auth != null; // Authenticated users can write
    }
    
    // Allow read/write access to authenticated users for location views
    match /locationViews/{document} {
      allow read, write: if request.auth != null;
    }
  }
}
